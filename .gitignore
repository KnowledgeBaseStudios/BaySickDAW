# Build output — regenerated by do_build.bat every time, no reason to track.
build/

# Claude / planning working notes — local-only.
Files For Claude/

# User-created projects + their backups + samples — runtime data, not source.
Projects/

# Per-machine audio settings (different audio interfaces per workstation).
audio_settings.xml
master_output.xml

# Runtime diagnostic logs — regenerated each launch, not source.
*_log.txt

# Auto-saved Untitled-project backups — runtime, not source.
Backups/Unsaved/

# Per-machine general settings (recent files, multi-core toggle, etc.) — modified every app launch.
settings.xml

# Claude agent worktrees — created by isolated-mode subagents; ephemeral, not source.
.claude/worktrees/

# Per-machine Claude Code permission grants — local-only by Claude convention (`*.local.*`).
.claude/settings.local.json

# User-created presets across every page / engine / effect — personal content, not stock.
# Stock factory presets live alongside (e.g. "Presets/Effects/Reverb/Hall.xml"); only the
# "My Presets" subfolders contain user-saved patches that shouldn't ship in the repo.
Presets/**/My Presets/
